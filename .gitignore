# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- tax engine additions (see audit/findings/FINDINGS.md F-008, F-009) ---
# `/out/` above is the Next.js static-export default and silently excluded the
# generated compliance report, which is a REQUIRED DELIVERABLE. Generated
# reports therefore live in /reports/ and ARE committed. Do not add /reports/
# to this file. Git cannot re-include a file inside an excluded directory, so
# moving the path is the only fix.
data/*.db
data/*.db-journal
data/*.db-wal
